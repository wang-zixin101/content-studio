# ============================================================
#  X 内容工作台 - 环境配置
#  复制本文件为 .env 并填入你的密钥。.env 不会提交到版本库。
# ============================================================

# ---------- AI 提供商（独立封装，可整体替换） ----------
# provider 类型：openai_compat（任何 OpenAI 兼容服务）
AI_PROVIDER=openai_compat

# 【实时】MiMo 按量付费：https://api.xiaomimimo.com/v1        （key 形如 sk-xxxxx）
#        MiMo Token Plan：https://token-plan-cn.xiaomimimo.com/v1 （key 形如 tp-xxxxx）
AI_BASE_URL=https://api.xiaomimimo.com/v1

# 在此填入你的 MiMo API Key（本文件是样板，请勿在这里填真实密钥；
# 真正的密钥请写进 backend/.env，该文件已被 .gitignore 排除）
AI_API_KEY=

# ---------- Batch（批量分析）----------
# MiMo 的 Batch 使用**独立端点**，与实时 Base URL 不同：
#   请从 MiMo「Batch Inference」页面获取形如 https://batch-api-<region>.xiaomimimo.com/v1 的地址
# 留空 = Batch 不可用（导入时会走实时 Pro，界面上会提示）。
AI_BATCH_BASE_URL=

# Batch 使用普通 sk-xxxxx 密钥；留空则复用上面的 AI_API_KEY。
# 注意：Token Plan 的 tp-xxxxx 不假设支持 Batch。
AI_BATCH_API_KEY=

# 分能力指定模型（全部走上面的 base_url，改这里即可换模型，无需改代码）
AI_MODEL_ANALYSIS=mimo-v2.6-pro
AI_MODEL_REWRITE=mimo-v2.6-pro
AI_MODEL_STYLE=mimo-v2.6-pro
# 批量分析（Batch API）使用的模型
AI_MODEL_BATCH=mimo-v2.6-pro

# 单次请求超时（秒）
AI_TIMEOUT=180

# ---------- 数据库 ----------
# 留空则使用 content-studio/data/content_studio.db
DB_PATH=

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000

# 允许的前端来源（开发默认 Vite）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
